
<div class="findings-carousel"><div class="findings-grid"><% for (let copy = 0; copy < 2; copy++) { %><div class="findings-set"<% if (copy === 1) { %> aria-hidden="true" inert<% } %>><% for (const item of items) { %><a class="finding-card" href="<%= item.url || item.path %>" aria-label="Read research: <%= item.title %>"><div class="finding-category"><%= item.category %></div><div class="finding-number"><%= item.number %></div><h3><%= item.title %></h3><p><%= item.description %></p><div class="finding-source"><em><%= item.journal %></em> · <%= item.year %></div></a><% } %></div><% } %></div></div>
