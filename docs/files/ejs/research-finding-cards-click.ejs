
<div class="findings-carousel"><button class="findings-prev" type="button" aria-label="Previous research finding">&#10094;</button><div class="findings-viewport"><div class="findings-grid"><% for (const item of items) { %><a class="finding-card" href="<%= item.url || item.path %>" aria-label="Read research: <%= item.title %>"><div class="finding-category"><%= item.category %></div><div class="finding-number"><%= item.number %></div><h3><%= item.title %></h3><p><%= item.description %></p><div class="finding-source"><em><%= item.journal %></em> · <%= item.year %></div></a><% } %></div></div><button class="findings-next" type="button" aria-label="Next research finding">&#10095;</button></div>
